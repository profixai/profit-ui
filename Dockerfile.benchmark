# profit-ui — benchmark-only Cloud Run image
#
# Identical build stage to the main Dockerfile.
# serve.json rewrites ALL requests to /benchmark.html so
# benchmark.myprofix.ai serves the standalone public benchmark tool
# regardless of path. No -s SPA fallback needed.

# Stage 1: build (Bun)
FROM oven/bun:1.3-slim AS builder
WORKDIR /app
COPY package.json bun.lock* bun.lockb* ./
RUN bun install --frozen-lockfile
COPY . .
ARG VITE_SUPABASE_URL=""
ARG VITE_SUPABASE_PUBLISHABLE_KEY=""
ARG VITE_APP_VERSION=prod
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY
ENV VITE_APP_VERSION=$VITE_APP_VERSION
RUN bun run build

# Stage 2: serve (Node + serve)
FROM node:20-slim AS runtime
WORKDIR /app
RUN npm install -g serve@14 && npm cache clean --force
COPY --from=builder /app/dist /app/dist
RUN printf '{"rewrites":[{"source":"/**","destination":"/benchmark.html"}]}' > /app/dist/serve.json
EXPOSE 3000
CMD ["serve", "/app/dist", "-l", "3000"]
