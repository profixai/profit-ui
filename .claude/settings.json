{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-sonnet-4-6",
  "env": {
    "PROFIX_CLAUDE_DEFAULT_MODEL": "claude-sonnet-4-6",
    "PROFIX_CLAUDE_PLANNING_MODEL": "claude-opus-4-7"
  },
  "permissions": {
    "allow": [
      "Bash(bun install)",
      "Bash(bun run dev)",
      "Bash(bun run build)",
      "Bash(bun run test)",
      "Bash(npx tsc --noEmit)",
      "Bash(npm run build)",
      "Bash(npm run test)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Read(**)",
      "Edit(src/**)",
      "Edit(public/**)",
      "Edit(docs/**)",
      "Edit(.claude/**)",
      "Write(src/**)",
      "Write(public/**)",
      "Write(docs/**)",
      "Write(.claude/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Write(.env)",
      "Write(.env.*)",
      "Edit(src/contracts/index.ts)",
      "Bash(git push * main)",
      "Bash(git push origin main)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(bun add *)",
      "Bash(npm install *)",
      "Bash(bun remove *)"
    ]
  }
}
